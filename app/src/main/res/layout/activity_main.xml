<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:paddingStart="8dp" android:paddingEnd="8dp" app:title="@string/app_title" />
    <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="32dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/subtitle" android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface" android:layout_marginTop="12dp" />
            <TextView android:id="@+id/save_status" style="@style/Near.Caption"
                android:layout_marginTop="8dp" android:text="@string/local_save" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="24dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/script" android:textAppearance="?attr/textAppearanceTitleMedium" />
                <com.google.android.material.button.MaterialButton android:id="@+id/library"
                    style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                    android:layout_height="48dp" android:text="@string/library" />
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/title_hint" style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/script_title"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences"
                    android:maxLines="1" android:maxLength="80" android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:hint="@string/body_hint"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox" app:hintEnabled="false">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/script_body"
                    android:layout_width="match_parent" android:layout_height="240dp" android:gravity="top|start"
                    android:hint="@string/body_hint" android:inputType="textMultiLine|textCapSentences"
                    android:textSize="17sp" android:lineSpacingExtra="4dp" android:scrollbars="vertical"
                    android:padding="16dp" android:maxLength="100000" android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@+id/script_stats" style="@style/Near.Caption" android:layout_marginTop="8dp" />

            <TextView style="@style/Near.Section" android:text="@string/preview" />
            <com.mastermoh.near.ReaderView android:id="@+id/reader_preview"
                android:layout_width="match_parent" android:layout_height="156dp"
                android:contentDescription="@string/preview" />
            <TextView style="@style/Near.Caption" android:layout_marginTop="8dp" android:text="@string/preview_hint" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="28dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/text_size" android:textAppearance="?attr/textAppearanceTitleMedium" />
                <TextView android:id="@+id/size_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelLarge" android:textColor="?attr/colorPrimary" />
            </LinearLayout>
            <com.google.android.material.slider.Slider android:id="@+id/text_size"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:contentDescription="@string/text_size" android:valueFrom="18" android:valueTo="42" android:stepSize="1" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="16dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/speed" android:textAppearance="?attr/textAppearanceTitleMedium" />
                <TextView android:id="@+id/speed_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelLarge" android:textColor="?attr/colorPrimary" />
            </LinearLayout>
            <com.google.android.material.slider.Slider android:id="@+id/pace"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:contentDescription="@string/speed" android:valueFrom="60" android:valueTo="220" android:stepSize="5" />
            <TextView style="@style/Near.Caption" android:text="@string/speed_hint" />

            <TextView style="@style/Near.Section" android:text="@string/width" />
            <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/width_group"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:singleSelection="true" app:selectionRequired="true">
                <com.google.android.material.button.MaterialButton android:id="@+id/width_narrow"
                    style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="@string/narrow" />
                <com.google.android.material.button.MaterialButton android:id="@+id/width_medium"
                    style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="@string/medium" />
                <com.google.android.material.button.MaterialButton android:id="@+id/width_wide"
                    style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="@string/wide" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/countdown"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                android:layout_marginTop="20dp" android:text="@string/countdown" />
            <TextView style="@style/Near.Caption" android:text="@string/countdown_hint" />

        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp"
        android:paddingTop="8dp" android:paddingBottom="12dp" android:background="?attr/colorSurface">
        <com.google.android.material.button.MaterialButton android:id="@+id/record_in_near"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:text="@string/record_in_near" />
        <com.google.android.material.button.MaterialButton android:id="@+id/launch"
            style="@style/Widget.Material3.Button.OutlinedButton" android:layout_marginTop="8dp"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/launch" />
        <com.google.android.material.button.MaterialButton android:id="@+id/close_reader"
            style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp"
            android:text="@string/close_reader" android:visibility="gone" />
        <TextView style="@style/Near.Caption" android:layout_marginTop="8dp" android:text="@string/launch_hint" />
    </LinearLayout>
</LinearLayout>
