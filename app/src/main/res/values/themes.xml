<resources>
    <style name="Theme.Near" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/near_primary</item>
        <item name="colorOnPrimary">@color/near_on_primary</item>
        <item name="colorPrimaryContainer">@color/near_container</item>
        <item name="colorOnPrimaryContainer">@color/near_on_container</item>
        <item name="colorSecondary">@color/near_primary</item>
        <item name="colorOnSecondary">@color/near_on_primary</item>
        <item name="colorSecondaryContainer">@color/near_container</item>
        <item name="colorOnSecondaryContainer">@color/near_on_container</item>
        <item name="colorSurface">@color/near_surface</item>
        <item name="colorOnSurface">@color/near_on_surface</item>
        <item name="colorSurfaceVariant">@color/near_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/near_secondary</item>
        <item name="colorSurfaceContainer">@color/near_surface_variant</item>
        <item name="colorSurfaceContainerHigh">@color/near_surface_variant</item>
        <item name="colorSurfaceContainerHighest">@color/near_surface_variant</item>
        <item name="colorOutline">@color/near_outline</item>
        <item name="android:windowBackground">@color/near_surface</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">@color/near_surface</item>
        <item name="android:statusBarColor">@color/near_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Near.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/near_on_surface</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="Near.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/near_secondary</item>
    </style>
</resources>
